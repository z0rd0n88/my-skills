#!/usr/bin/env python3
"""Stand-in for `claude` in tests/run-job.sh. run-job starts it as
`claude --settings <dir>/settings.json '<prompt>'` with JOB_DIR and JOB_CHILD set.
What child N does is word N of the file named by FAKE_PLAN:

  finish      set `status: done` in checkpoint.md, fire Stop
  progress    append a line to checkpoint.md, fire Stop
  noop        fire Stop without touching checkpoint.md
  crash       exit 3 at once, no hook
  exit75      exit 75 (claude's usage-limit exit), no hook
  overloaded  fire StopFailure with error "overloaded"
  rate_limit  fire StopFailure with error "rate_limit"
  hang        never finish its turn
  badjson     append progress, fire Stop with a payload that is not JSON
  truststart  show the trust dialog text at once, wait up to 5 s for keys, then progress
  trustlate   work 2.5 s, then show the trust dialog text, wait 2.5 s, then progress
  Background shells, as Claude Code shows them: the screen has the input box between two rules and a
  status line under it, "⏵⏵ auto mode on" plus " · 1 shell" while a background shell is listed and
  " · esc to interrupt" while a turn runs. The shell's argv sources
  .../.claude/shell-snapshots/snapshot-bash-$FAKE_TAG.sh, as the Bash tool's does.
  background  turn starts a 3 s background shell and ends (Stop, no progress); when the shell
              ends, 1.2 s later a turn of its own (1 s) appends progress and fires Stop again
  bglate      the shell (1 s) ends while the turn still runs (2.5 s); the turn of its own still
              follows the Stop, 1.2 s later
  bgtree      like background, but the status line never lists the shell (process tree only)
  bgfooter    like background, but only the status line lists it (no process)
  bgnofollow  a 2 s shell, and no turn follows it
  bgforever   a 60 s shell, and no turn follows it
  bgagent     append progress, then end the turn with a background subagent listed as seen live
              (a "◯ general-purpose" row under the status line, " · 1 monitor" in it) for good; its
              own command runs as a Bash-tool shell under claude that the status line does not list
After its turn it idles at its "prompt" like claude does. Any keys typed into the pane are appended
to $JOB_DIR/keys-<N>, so a test can tell whether run-job typed into a child."""
import json
import os
import re
import select
import subprocess
import sys
import time

TAG = os.environ.get("FAKE_TAG", "fake")
RULE = "\u2500" * 78


def bg_shell(secs):
    # `; true` keeps bash from exec'ing sleep and losing its argv, as the Bash tool's trailing commands do
    return subprocess.Popen(["bash", "-c", f"source /nonexistent/.claude/shell-snapshots/snapshot-bash-{TAG}.sh"
                             f" 2>/dev/null; sleep {secs}; true"])


def screen(text, busy=False, shells=0, agents=0):
    status = "  \u23f5\u23f5 auto mode on" + (f" \u00b7 {shells} shell" if shells else "") \
        + (f" \u00b7 {agents} monitor" if agents else "") + (" \u00b7 esc to interrupt" if busy else "")
    rows = ["  \u25cf main"] + ["  \u25ef general-purpose  waiting on 1 monitor \u00b7 probe"] * agents if agents else []
    print("\x1b[2J\x1b[H" + "\n".join([text, "", RULE, "\u276f ", RULE, status] + rows), flush=True)


args = sys.argv[1:]
hooks = json.load(open(args[args.index("--settings") + 1]))["hooks"]
job, n = os.environ["JOB_DIR"], int(os.environ["JOB_CHILD"])
plan = open(os.environ["FAKE_PLAN"]).read().split()
mode = plan[n - 1] if n <= len(plan) else "finish"
checkpoint = os.path.join(job, "checkpoint.md")


def fire(kind, payload):
    cmd = hooks[kind][0]["hooks"][0]["command"]
    subprocess.run(cmd, shell=True, input=payload, text=True, check=False)


def event(msg, **extra):
    return json.dumps({"session_id": f"fake-{n}", "transcript_path": "/dev/null",
                       "last_assistant_message": msg, **extra})


def progress():
    with open(checkpoint, "a") as f:
        f.write(f"\nprogress by child {n}\n")


def idle(seconds=None, until_keys=False):
    end = time.time() + seconds if seconds else None
    while end is None or time.time() < end:
        if select.select([sys.stdin], [], [], 0.2)[0]:
            data = os.read(0, 1024)
            if not data:
                return
            with open(os.path.join(job, f"keys-{n}"), "ab") as f:
                f.write(data)
            if until_keys:
                return


print(f"fake child {n}: {mode}", flush=True)
# What this child sees of the runner's environment, so a test can tell whose environment it got.
with open(os.path.join(job, f"env-{n}"), "w") as f:
    f.write(os.environ.get("RUNJOB_PROBE", ""))
time.sleep(float(os.environ.get("FAKE_DELAY", "0.3")))
if mode == "finish":
    text = open(checkpoint).read()
    open(checkpoint, "w").write(re.sub(r"(?m)^status:.*$", "status: done", text, count=1))
    fire("Stop", event("job finished"))
elif mode == "progress":
    progress(); fire("Stop", event("made progress"))
elif mode == "noop":
    fire("Stop", event("did nothing"))
elif mode == "crash":
    sys.exit(3)
elif mode == "exit75":
    sys.exit(75)
elif mode in ("overloaded", "rate_limit"):
    fire("StopFailure", event("", error=mode))
elif mode == "badjson":
    progress(); fire("Stop", "this is not json")
elif mode == "truststart":
    print("Do you trust the files in this folder?\n> Yes, I trust this folder", flush=True)
    idle(5, until_keys=True); progress(); fire("Stop", event("trust answered"))
elif mode == "bgagent":
    sub = bg_shell(60)   # the subagent's own (foreground) command: under claude, unlisted
    progress(); screen("Started a background agent.", agents=1)
    fire("Stop", event("started a background agent"))
elif mode.startswith("bg") or mode == "background":
    listed = 0 if mode == "bgtree" else 1
    secs = {"bglate": 1, "bgnofollow": 2, "bgforever": 60}.get(mode, 3)
    shell = None if mode == "bgfooter" else bg_shell(secs)
    screen("Starting the tests in the background.", busy=True, shells=listed)
    if mode == "bglate":
        shell.wait(); screen("Writing a long summary.", busy=True); time.sleep(1.5)
    screen("Waiting for the background command to finish.", shells=0 if mode == "bglate" else listed)
    fire("Stop", event("Waiting for the background command to finish."))
    if mode not in ("bgnofollow", "bgforever"):
        shell.wait() if shell else time.sleep(secs)
        screen("Background command completed.")
        time.sleep(1.2)   # Claude Code starts its own turn about a second after the shell ends
        screen("Background command completed.", busy=True); time.sleep(1)
        progress(); screen("Background work done."); fire("Stop", event("background work done"))
    elif shell and mode == "bgnofollow":
        shell.wait(); screen("Waiting for the background command to finish.")
elif mode == "trustlate":
    time.sleep(2.5)
    print("Reading run-job: ... grep -q 'Yes, I trust this folder' ...", flush=True)
    idle(2.5); progress(); fire("Stop", event("trust text shown late"))
idle()
