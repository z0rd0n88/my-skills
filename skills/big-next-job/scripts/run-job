#!/usr/bin/env bash
# run-job: drive one big-next-job to completion with a chain of fresh Claude Code sessions.
# Each child reads <job-dir>/checkpoint.md, works until the phase ends (or its context gets heavy),
# rewrites checkpoint.md, and stops. This loop relaunches until status is done or blocked.
# A crashed, killed, or timed-out child costs nothing but the work since its last checkpoint.
# Mechanism borrowed from session-switcher (z0rd0n88/session-stickler): brief as one argv,
# a Claude Stop hook as the return channel, tmux as the terminal. Needs claude, tmux, python3, flock.
# For an unattended multi-phase coding job with receipts, CI checks and usage-limit pauses, use
# blast-off (z0rd0n88/blast-off); its fixes to this loop are ported back here.
#
# Usage:  run-job <job-dir> [workdir]          (job-dir holds brief.md + checkpoint.md)
#         run-job status <job-dir>             (print the checkpoint header and stop)
#   env:  CLAUDE_FLAGS=""             extra flags for each child; the owner sets what the run may use
#         JOB_CHILD_TIMEOUT=14400     seconds one child may work before it is killed and replaced
#         JOB_MAX_CHILDREN=12         children this run may launch
#         JOB_API_BACKOFF=600         wait after an overloaded/server API error before the next child
#         JOB_LIMIT_BACKOFF=1800      wait after a rate limit (or claude exit 75) before the next child
#         JOB_TRUST_SECONDS=60        answer a child's trust dialog only this long after it starts
#         JOB_BG_WAIT=1800            a child whose turn ends with background work running (a
#                                     shell, a monitor or a subagent) is waited on this long (time
#                                     held excluded) for the turn that work's end starts, then
#                                     closed; with JOB_CHILD_TIMEOUT smaller, that comes first. The
#                                     child counts as a stall if it made no progress
#         JOB_BG_SETTLE=10            once a child showed background work, its Stop counts only
#                                     after this many quiet seconds (its follow-up turn starts ~1 s
#                                     after the work ends)
#         JOB_SESSION=job-<name>      tmux session name;  JOB_KEEP_WINDOWS=1 leaves finished children open
# Watch:  the attach command run-job prints (tmux -L run-job-<name>-<hash> attach -t job-<name>);
#         each job has its own tmux server
# `session-airspace` can hold a child (held time does not count toward JOB_CHILD_TIMEOUT).
# Child numbers continue across runs ($JOB/child-count).
# Exit:   0 done · 1 error (bad input, or another run-job drives this job) · 3 blocked (needs the owner)
#         4 child cap reached · 5 two children in a row made no progress
set -euo pipefail

die() { echo "run-job: $*" >&2; exit 1; }
case "${1:-}" in
  -h|--help|"") sed -n '2,/^set -euo/p' "$0" | sed '$d'; exit 0 ;;
  status) [ -n "${2:-}" ] || die "usage: run-job status <job-dir>"
          [ -f "$2/checkpoint.md" ] || die "no $2/checkpoint.md; is $2 a job dir?"
          sed -n '1,/^## /p' "$2/checkpoint.md" | sed '$d'
          [ ! -s "$2/child-count" ] || echo "children launched so far: $(cat "$2/child-count")"; exit 0 ;;
esac

JOB="$(cd "$1" && pwd)" || die "no job dir $1"
WORKDIR="$(cd "${2:-$(dirname "$JOB")}" && pwd)" || die "no workdir ${2:-}"
NAME="$(basename "$WORKDIR")"; NAME="${NAME//[^A-Za-z0-9_-]/_}"   # tmux socket/session-safe
SESSION="${JOB_SESSION:-job-$NAME}"
# The job dir, not the workdir name, identifies the job: two jobs in ~/a/api and ~/b/api (or in one
# workdir) must never share a tmux server, or starting one kills the other's child. The lock uses the
# same hash, so "one runner per job" and "one server per job" agree.
JOB_HASH="$(printf '%s' "$JOB" | sha256sum | cut -c1-16)"
SOCK="run-job-${NAME:0:40}-${JOB_HASH:0:8}"   # tmux -L run-job-<name>-<hash>; short enough for a socket path
LOG="$JOB/run.log"

# Numbers: whole, at most 9 digits, no leading zero (bash reads 010 as 8 and 08 as an error).
for v in JOB_CHILD_TIMEOUT JOB_MAX_CHILDREN JOB_API_BACKOFF JOB_LIMIT_BACKOFF JOB_TRUST_SECONDS JOB_BG_WAIT JOB_BG_SETTLE; do
  [[ ${!v:-0} =~ ^(0|[1-9][0-9]{0,8})$ ]] || die "$v=${!v} is not a whole number (at most 9 digits, no leading zero)"
done
TIMEOUT="${JOB_CHILD_TIMEOUT:-14400}"
MAXC="${JOB_MAX_CHILDREN:-12}"
TRUST_SECONDS="${JOB_TRUST_SECONDS:-60}"
BG_WAIT="${JOB_BG_WAIT:-1800}"
BG_SETTLE="${JOB_BG_SETTLE:-10}"
LIMIT_EXIT=75   # claude's exit code for a usage-limit error (sysexits EX_TEMPFAIL)

for b in claude tmux python3 flock; do command -v "$b" >/dev/null || die "$b not on PATH"; done
test -s "$JOB/brief.md" || die "missing $JOB/brief.md"
test -s "$JOB/checkpoint.md" || die "missing $JOB/checkpoint.md"

status() { sed -n 's/^status: *\([a-z-]*\).*/\1/p' "$JOB/checkpoint.md" | head -1; }
log() { printf '%s %s\n' "$(date -u +%FT%TZ)" "$*" | tee -a "$LOG"; }
fingerprint() { sha256sum "$JOB/checkpoint.md" | cut -c1-16; }
proc_state() { awk '/^State:/ {print $2}' "/proc/$1/status" 2>/dev/null; }

# --- One runner per job. Two would launch children into the same checkpoint and kill each other's
# windows. flock(1) holds the lock on fd 9 for as long as this process lives; the kernel drops it when
# the process dies, however it dies, so there is no stale lock to take over (taking one over by hand
# let two runners that started together both win). The file only records who holds it, and stays:
# deleting it would let a runner that opened the old file and one that makes a new file both lock.
LOCK="${XDG_RUNTIME_DIR:-/tmp}/run-job-$JOB_HASH.lock"
exec 9>>"$LOCK" || die "cannot open lock $LOCK"
if ! flock -n 9; then
  { read -r lpid _ < "$LOCK"; } 2>/dev/null || true
  die "${lpid:+run-job $lpid}${lpid:-another run-job} already drives $JOB (lock $LOCK); stop it first, or wait for it"
fi
: > "$LOCK"; echo "$$ $(date -u +%FT%TZ)" >&9

# --- Stopping run-job stops its child: an orphan would keep editing checkpoint.md with no runner to
# notice, and the next run would launch a second child beside it. JOB_KEEP_WINDOWS leaves it open.
WIN='' DIR=''
cleanup() {
  trap '' HUP INT TERM
  if [ -z "${JOB_KEEP_WINDOWS:-}" ]; then
    [ -z "$DIR" ] || rm -rf "$DIR"
    tmux -L "$SOCK" kill-server 2>/dev/null || true
  fi
}
trap cleanup EXIT
trap 'log "run-job stopped by signal; closing child"; exit 143' TERM
trap 'exit 129' HUP
trap 'exit 130' INT

# Child numbers continue across runs, so run.log and window names stay unique. The cap counts this run.
LAUNCHED=0
if [ -e "$JOB/child-count" ]; then
  LAUNCHED="$(cat "$JOB/child-count")"
  [[ $LAUNCHED =~ ^(0|[1-9][0-9]{0,8})$ ]] || die "$JOB/child-count is not a number; fix or delete it"
fi

# The child's whole instruction. The brief and checkpoint carry everything else, so this stays
# constant and the chain never depends on a hand-written handoff.
PROMPT="Continue the job in $JOB. Read $JOB/checkpoint.md first, then $JOB/brief.md, then follow the brief's Child protocol section exactly. Work from $WORKDIR."

# A private tmux server per job. A window takes its environment from its server, fixed when the server
# started, so on the shared default server a child would get whatever PATH or GH_TOKEN that server was
# started with, not this run's. -f /dev/null keeps the owner's tmux.conf (pane-died hooks, renumbering)
# away from the children. We hold the job's lock, so a server left by an earlier run is stale: stop it,
# but first save the screens of its windows (JOB_KEEP_WINDOWS keeps them for inspection) to run.log.
# CLAUDE* names are scrubbed so a child does not think it is nested inside this session.
if tmux -L "$SOCK" has-session 2>/dev/null; then
  log "closing the tmux server an earlier run left ($SOCK); its windows' last screens follow"
  for p in $(tmux -L "$SOCK" list-panes -a -F '#{pane_id}' 2>/dev/null); do
    { echo "--- window $(tmux -L "$SOCK" display -p -t "$p" '#{window_name}' 2>/dev/null): last screen ---"
      tmux -L "$SOCK" capture-pane -p -t "$p" -S -40 2>/dev/null | sed '/^[[:space:]]*$/d'
      echo "---"; } >> "$LOG"
  done
fi
tmux -L "$SOCK" kill-server 2>/dev/null || true
SCRUB=$(env | grep -o '^CLAUDE[A-Z_]*=' | sed 's/=$//; s/^/-u /' || true)
# 9>&-: the tmux server (and every child it starts) must not inherit the lock's fd, or a server kept
# by JOB_KEEP_WINDOWS would hold the lock after this run ends.
env $SCRUB tmux -f /dev/null -L "$SOCK" new-session -d -s "$SESSION" -c "$WORKDIR" 9>&-
# The pane outlives claude, so a death shows as #{pane_dead} with the last screen still there to log.
tmux -L "$SOCK" set-option -g remain-on-exit on

# launch <n>: DIR (settings, done.json, failed.json, exit) and WIN, the pane id (%N). A pane id
# never points at another window; a "session:index" target of a closed window can (tmux reuses it).
launch() {
  local n="$1" q
  DIR=$(mktemp -d "${XDG_RUNTIME_DIR:-/tmp}/job.XXXXXX")
  # Stop: the turn ended. StopFailure: an API error ended it; claude then idles at its prompt, so
  # without this hook the runner would wait out JOB_CHILD_TIMEOUT. Both write by rename, so the
  # runner never reads a half-written file.
  printf '{"hooks":{"Stop":[{"hooks":[{"type":"command","command":"cat > %s/done.tmp && mv %s/done.tmp %s/done.json"}]}],"StopFailure":[{"hooks":[{"type":"command","command":"cat > %s/failed.tmp && mv %s/failed.tmp %s/failed.json"}]}]}}\n' \
    "$DIR" "$DIR" "$DIR" "$DIR" "$DIR" "$DIR" > "$DIR/settings.json"
  q="'$(printf '%s' "$PROMPT" | sed "s/'/'\\\\''/g")'"
  # The command after claude keeps the pane's shell as claude's parent (tmux would SIGCONT a held
  # pane process at once, so session-airspace could never hold it) and records claude's exit status.
  WIN=$(tmux -L "$SOCK" new-window -dP -F '#{pane_id}' -t "$SESSION" -n "child-$n" -c "$WORKDIR" -e JOB_DIR="$JOB" -e JOB_CHILD="$n" \
        "claude ${CLAUDE_FLAGS:-} --settings $DIR/settings.json $q; echo \$? > $DIR/exit") \
    || { log "child $n could not be launched: tmux server $SOCK is gone (killed from outside?); stopping"; exit 1; }
  PANE=$(tmux -L "$SOCK" display -p -t "$WIN" '#{pane_pid}' 2>/dev/null || true)
  log "child $n launched  window=$SESSION:child-$n  (watch: tmux -L $SOCK attach -t $SESSION)"
}

# bg_status: sets BG_BUSY (a turn runs) and BG_NEW (background work running). Claude Code can end a
# turn while work it started in the background still runs (a shell, a monitor, a subagent), and
# starts a new turn by itself when that work finishes. Two signals, checked live:
# - The status line under the input box counts it: "⏵⏵ auto mode on · 1 shell · ↓ to manage",
#   "· 1 shell, 1 monitor ·", or "· 3 background tasks ·" while a subagent runs. It shows during a
#   turn too, and never counts a foreground command; "esc to interrupt" there means a turn runs.
#   Each subagent is also a row under it ("◯ general-purpose <task>"; "● main" is the session).
#   Only the lines under the input box's lower rule are read (the transcript above can hold the same
#   words), and row text (a subagent's task) is never counted.
# - The Bash tool runs each command as `bash -c 'source <home>/.claude/shell-snapshots/snapshot-...'`
#   under claude, monitors too. Between turns any such shell still alive is background work (during
#   a turn a foreground command looks the same, and so does a subagent's while its row shows, so the
#   tree is read only between turns with no row). Only the outermost of a shell's subshells counts.
# The same rules as session-stickler's session_panes.py.
bg_status() {
  local work rows tree=0
  read -r BG_BUSY work rows < <(tmux -L "$SOCK" capture-pane -p -t "$WIN" 2>/dev/null | python3 -c '
import re, sys
lines = sys.stdin.read().splitlines()[-40:]
row = re.compile(r"^\s*[◯●]\s+\S")
rules = [i for i, line in enumerate(lines) if re.match(r"^\s*─{8,}\s*$", line)]
if rules:
    tail = lines[rules[-1] + 1:]
else:   # no rule: the rows at the very bottom and the two non-blank lines above them
    tail = [l for l in lines if l.strip()]
    n = len(tail)
    while n and row.match(tail[n - 1]):
        n -= 1
    tail = tail[max(0, n - 2):]
rows = sum(1 for l in tail if re.match(r"^\s*◯\s+\S", l))
status = "\n".join(l for l in tail if not row.match(l))
counted = sum(int(c) for c in re.findall(r"(?:^|[·,])\s*(\d+)\s+(?:background\s+)?(?:shells?|monitors?|tasks?)\b", status, re.M))
print(int("esc to interrupt" in status), max(counted, rows), rows)' 2>/dev/null || echo "0 0 0")
  if [ "${BG_BUSY:-0}" != 1 ] && [ "${rows:-0}" = 0 ]; then
    tree=$(ps -eo pid=,ppid=,args= | awk -v root="${PANE:-0}" -v mark="/shell-snapshots/snapshot-" '
      { pid = $1; par[pid] = $2; $1 = $2 = ""; arg[pid] = $0 }
      END { for (p in par) {
              if (!index(arg[p], mark) || index(arg[par[p]], mark)) continue
              for (a = par[p]; a > 1 && d < 64; a = par[a]) { d++; if (a == root) { c++; break } }
              d = 0 }
            print c + 0 }')
  fi
  BG_NEW=$(( ${work:-0} > tree ? ${work:-0} : tree ))
}

# turn_ended: done.json holds a Stop that is the child's last word for now. Not while background
# work runs, or a turn (the one that work's end starts): wait for that, up to BG_WAIT of unheld time
# for work that never ends (a dev server, a monitor with no end). And once background work was seen
# at all, only after BG_SETTLE quiet seconds: work that ends while Claude writes its last message
# leaves nothing to see at the Stop, yet its turn follows about a second later.
turn_ended() {
  [ -s "$DIR/done.json" ] || return 1
  if [ "$BG_NEW" -gt 0 ] || [ "$BG_BUSY" = 1 ]; then
    bg_quiet=''
    if [ "$BG_NEW" -gt 0 ]; then
      if [ -z "$bg_since" ]; then
        bg_since=$SECONDS bg_held0=$held
        log "child $n ended its turn with background work running (shells, monitors or subagents); waiting for the turn it starts (up to ${BG_WAIT}s)"
      fi
      if [ $((SECONDS - bg_since - (held - bg_held0))) -ge "$BG_WAIT" ]; then
        # Close it even with JOB_KEEP_WINDOWS: left open, it would wake when the work ends and
        # edit the checkpoint beside the next child.
        log "child $n still has background work after ${BG_WAIT}s; taking its last reply and closing it"
        BG_LEFT=1; return 0
      fi
    fi
    return 1
  fi
  [ "$bg_seen" = 1 ] || return 0
  [ -n "$bg_quiet" ] || bg_quiet=$SECONDS
  [ $((SECONDS - bg_quiet)) -ge "$BG_SETTLE" ]
}

# wait_child: 0 the turn ended (done.json), 1 timed out, 2 claude exited first (AGE, RC),
# 3 an API error ended the turn (failed.json). Time is the clock ($SECONDS), not loop turns, less any
# time session-airspace held the child. A failed read (window gone, or a tmux hiccup) counts as a
# death only on the second in a row.
wait_child() {
  local start=$SECONDS last=$SECONDS held=0 now d miss=0 cpid bg_since='' bg_held0=0 bg_quiet='' bg_seen=0
  while :; do
    [ -s "$DIR/failed.json" ] && return 3
    bg_status; [ "$BG_NEW" -gt 0 ] && bg_seen=1
    turn_ended && return 0
    d=$(tmux -L "$SOCK" display -p -t "$WIN" '#{pane_dead}' 2>/dev/null) || d=
    case "$d" in 0) miss=0 ;; 1) miss=2 ;; *) miss=$((miss+1)) ;; esac
    if [ "$miss" -ge 2 ]; then
      [ -s "$DIR/done.json" ] && return 0   # the hook's rename ends before claude exits
      [ -s "$DIR/failed.json" ] && return 3
      AGE=$((SECONDS-start))
      RC=$(cat "$DIR/exit" 2>/dev/null || tmux -L "$SOCK" display -p -t "$WIN" '#{pane_dead_status}' 2>/dev/null || true)
      return 2
    fi
    now=$SECONDS
    cpid=$(pgrep -P "${PANE:-0}" 2>/dev/null | head -1 || true)
    [ -z "$cpid" ] || [ "$(proc_state "$cpid")" != T ] || held=$((held + now - last))
    last=$now
    [ $((now - start - held)) -le "$TIMEOUT" ] || return 1
    # A folder Claude has not seen shows a trust dialog; the job's worktrees are owner-created, so it
    # is answered (owner decision 2026-10-28). Only while claude starts: later the same text can be on
    # screen in a working child (this very script holds it), and keys sent then would reach its session.
    # ponytail: screen scrape; replace if claude grows a --trust flag.
    if [ $((now - start)) -lt "$TRUST_SECONDS" ] &&
       [[ $(tmux -L "$SOCK" capture-pane -p -t "$WIN" 2>/dev/null) == *"Yes, I trust this folder"* ]]; then
      tmux -L "$SOCK" send-keys -t "$WIN" Down Enter; sleep 2
    fi
    sleep 1
  done
}

# report <n> <file>: the Stop or StopFailure payload into run.log; a bad payload is logged, never fatal.
report() {
  python3 - "$DIR/$2" "$1" >> "$LOG" <<'PY'
import json, sys
raw = open(sys.argv[1], errors="replace").read()
try:
    ev = json.loads(raw)
except ValueError:
    ev = None
if not isinstance(ev, dict):
    print(f"child {sys.argv[2]} hook payload is not a JSON object: {raw[:200].strip()}")
    sys.exit(0)
print(f"child {sys.argv[2]} session={ev.get('session_id')} transcript={ev.get('transcript_path')}")
if ev.get("error"):
    print(f"child {sys.argv[2]} API error={ev.get('error')}")
print("--- child's last message ---")
print(ev.get("last_assistant_message") or "(none)")
print("---")
PY
  sed -n "/^child $1 /,/^---$/p" "$LOG" | tail -n 40
}

# api_error: the StopFailure payload's error name, reduced to name characters; empty when none.
api_error() {
  python3 -c 'import json,re,sys
try: e = json.load(open(sys.argv[1])).get("error")
except Exception: e = None
print(re.sub(r"[^A-Za-z0-9_-]", "", e) if isinstance(e, str) else "")' "$DIR/failed.json" 2>/dev/null || true
}

screen() {
  { echo "--- child's last screen ---"
    tmux -L "$SOCK" capture-pane -p -t "$WIN" -S -40 2>/dev/null | sed '/^[[:space:]]*$/d' || echo "(window gone)"
    echo "---"; } >> "$LOG"
}

# close_child [force]: JOB_KEEP_WINDOWS keeps a child that ended its turn; any other end closes it.
close_child() {
  if [ -z "${JOB_KEEP_WINDOWS:-}" ] || [ "${1:-}" = force ]; then
    tmux -L "$SOCK" kill-window -t "$WIN" 2>/dev/null || true
    rm -rf "$DIR"
  fi
  WIN='' DIR=''
}

ran=0 stalls=0 back=''
while :; do
  s="$(status)"
  case "$s" in
    done)    log "job done";    exit 0 ;;
    blocked) log "job blocked; see $JOB/checkpoint.md"; exit 3 ;;
  esac
  ran=$((ran+1)); [ "$ran" -le "$MAXC" ] || { log "child cap $MAXC reached for this run"; exit 4; }
  if [ -n "$back" ]; then sleep "$back" & wait $!; back=''; fi   # `& wait`: a signal stops it at once
  before="$(fingerprint)"
  lines=$(wc -l < "$JOB/checkpoint.md")
  [ "$lines" -le 150 ] || log "checkpoint.md is $lines lines; every child re-reads it whole, so move ledgers and detail to other files"

  n=$((LAUNCHED+1)); LAUNCHED=$n
  echo "$n" > "$JOB/child-count.tmp" && mv -f "$JOB/child-count.tmp" "$JOB/child-count"
  launch "$n"
  BG_LEFT=''; w=0; wait_child || w=$?
  apierr=''
  case "$w" in
    0) report "$n" done.json; close_child ${BG_LEFT:+force} ;;
    1) log "child $n timed out after ${TIMEOUT}s of work; killing it, next child resumes from checkpoint"
       screen; close_child force ;;
    3) report "$n" failed.json; err="$(api_error)"; close_child force; apierr=1
       case "$err" in
         rate_limit) back="${JOB_LIMIT_BACKOFF:-1800}" ;;
         overloaded|server_error|unknown) back="${JOB_API_BACKOFF:-600}" ;;
       esac
       log "child $n ended on API error ${err:-?}; next child${back:+ in ${back}s}, from checkpoint" ;;
    *) log "child $n exited without finishing its turn after ${AGE}s (exit ${RC:-?}); its screen follows, next child resumes from checkpoint"
       screen; close_child force
       if [ "${RC:-}" = "$LIMIT_EXIT" ]; then back="${JOB_LIMIT_BACKOFF:-1800}"; apierr=1; log "exit $LIMIT_EXIT is a usage limit; next child in ${back}s"; fi ;;
  esac

  if [ "$(fingerprint)" = "$before" ]; then
    if [ -n "$apierr" ]; then
      log "child $n left checkpoint.md unchanged after an API or usage error; not counted as a stall"
    else
      stalls=$((stalls+1)); log "child $n left checkpoint.md unchanged (stall $stalls/2)"
      [ "$stalls" -lt 2 ] || { log "two stalls; stopping"; exit 5; }
    fi
  else
    stalls=0
  fi
done
